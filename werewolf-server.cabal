cabal-version: 3.0
name: werewolf-server
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
      Domain.Engine
    , Domain.Rules
    , Domain.Types
    , Domain.Validation
    , Domain.Night
    , Domain.RoleShuffle
    , Protocol.Json
    , Protocol.Types
    , Server.Broadcast
    , Server.Connection
    , Server.GameLoop
    , Server.Room
    , Server.Supervisor
    , Server.WebSocket
  hs-source-dirs: src
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.17 && <5
      , aeson >=2 && <3
      , bytestring >=0.11
      , stm >=2.5 && <3
      , websockets >=0.12 && <0.14
      , random >=1.2 && <2
executable werewolf-server
  main-is: Main.hs
  hs-source-dirs: app
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.17 && <5
    , bytestring >=0.11
    , http-types >=0.12
    , warp >=3.3
    , wai >=3.2
    , werewolf-server
    , wai-websockets >=3.0 && <4
    , websockets >=0.12 && <0.14
test-suite skeleton-test
  type: exitcode-stdio-1.0
  main-is: SkeletonSpec.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.17 && <5
    , werewolf-server


