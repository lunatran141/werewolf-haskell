cabal-version: 3.0
name: werewolf-server
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
      Domain.Engine
    , Domain.Rules
    , Domain.Types
    , Domain.Validation
    , Protocol.Json
    , Protocol.Types
    , Server.Broadcast
    , Server.Connection
    , Server.GameLoop
    , Server.Room
    , Server.WebSocket
  hs-source-dirs: src
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.17 && <5

executable werewolf-server
  main-is: Main.hs
  hs-source-dirs: app
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.17 && <5
    , bytestring >=0.11
    , http-types >=0.12
    , warp >=3.3
    , wai >=3.2

test-suite skeleton-test
  type: exitcode-stdio-1.0
  main-is: SkeletonSpec.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.17 && <5
    , werewolf-server


-- Bộ kiểm thử dành riêng cho Task T02.
-- Kiểm tra Smart Constructor, Validation và GameState Invariant.
-- Sử dụng Hspec cho Unit Test và QuickCheck cho Property Test.

test-suite t02-domain-test
  type: exitcode-stdio-1.0
  main-is: T02Main.hs
  hs-source-dirs: test
  other-modules:
      DomainT02Spec
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.17 && <5
    , werewolf-server
    , hspec >=2.10
    , QuickCheck >=2.14

test-suite t03-lobby-test
  type: exitcode-stdio-1.0
  main-is: T03LobbySpec.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.17 && <5
    , werewolf-server
    , hspec >=2.10