cabal-version: 3.0
name: werewolf-server
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
      Analytics.Store
    , Domain.Engine
    , Domain.Rules
    , Domain.Replay
    , Domain.Simulation
    , Domain.Types
    , Domain.Validation
    , Domain.Night
    , Domain.RoleShuffle
    , Protocol.Json
    , Protocol.Analytics
    , Protocol.Types
    , Server.Broadcast
    , Server.Config
    , Server.AnalyticsClient
    , Server.Connection
    , Server.GameLoop
    , Server.ReplayStore
    , Server.Room
    , Server.RoomWorker
    , Server.SafeLog
    , Server.Supervisor
    , Server.WebSocket
  hs-source-dirs: src
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.17 && <5
      , aeson >=2 && <3
      , bytestring >=0.11
      , directory >=1.3
      , filepath >=1.4
      , network >=3.1 && <4
      , stm >=2.5 && <3
      , websockets >=0.12 && <0.14
      , random >=1.2 && <2
      , deepseq >=1.4 && <1.6
      , parallel >=3.2 && <3.4
executable werewolf-server
  main-is: Main.hs
  hs-source-dirs: app
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.17 && <5
    , bytestring >=0.11
    , http-types >=0.12
    , warp >=3.3
    , wai >=3.2
    , werewolf-server
    , wai-websockets >=3.0 && <4
    , websockets >=0.12 && <0.14
    , wai-app-static >=3.1 && <3.3

executable analytics-worker
  main-is: AnalyticsWorker.hs
  hs-source-dirs: app
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.17 && <5
    , bytestring >=0.11
    , network >=3.1 && <4
    , werewolf-server

